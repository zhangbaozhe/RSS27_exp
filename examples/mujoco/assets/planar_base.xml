<mujoco model="pivopt planar base">
  <!-- Example-defined omnidirectional force-driven base; SI units. -->
  <option timestep="0.002" integrator="implicitfast"/>
  <worldbody>
    <light pos="0 -2 4"/>
    <geom type="plane" size="6 6 0.1" rgba="0.85 0.86 0.89 1"/>
    <body name="base" pos="0 0 0.16">
      <joint name="x" type="slide" axis="1 0 0"/>
      <joint name="y" type="slide" axis="0 1 0"/>
      <joint name="yaw" type="hinge" axis="0 0 1"/>
      <geom type="box" size="0.25 0.18 0.10" mass="5" rgba="0.3 0.35 0.45 1"/>
      <geom type="box" pos="0.22 0 0.11" size="0.06 0.03 0.015" mass="0" rgba="0.9 0.2 0.1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <actuator>
    <motor joint="x" ctrllimited="true" ctrlrange="-20 20"/>
    <motor joint="y" ctrllimited="true" ctrlrange="-20 20"/>
    <motor joint="yaw" ctrllimited="true" ctrlrange="-5 5"/>
  </actuator>
</mujoco>
