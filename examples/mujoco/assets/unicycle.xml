<mujoco model="pivopt differential drive">
  <!-- Example-defined SI parameters, not a hardware identification. -->
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <geom friction="1.2 0.005 0.0001" solref="0.01 1"/>
  </default>
  <custom>
    <!-- Selected operating range, rad/s; torque bounds are in actuator ctrlrange. -->
    <numeric name="wheel_speed_limit" data="8"/>
  </custom>
  <worldbody>
    <light pos="0 -2 4"/>
    <geom type="plane" size="6 6 0.1" rgba="0.85 0.86 0.89 1"/>
    <body name="base" pos="0 0 0.15">
      <freejoint/>
      <geom type="box" pos="0 0 0.04" size="0.22 0.16 0.05" mass="3" rgba="0.3 0.35 0.45 1"/>
      <geom type="box" pos="0.20 0 0.1" size="0.05 0.025 0.01" mass="0" rgba="0.9 0.2 0.1 1" contype="0" conaffinity="0"/>
      <body name="left_wheel" pos="0 0.25 -0.05">
        <joint name="left_wheel" axis="0 1 0" armature="0.002" damping="0.001"/>
        <geom name="left_tire" type="cylinder" quat="1 1 0 0" size="0.1 0.025" mass="0.3" rgba="0.08 0.08 0.08 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.25 -0.05">
        <joint name="right_wheel" axis="0 1 0" armature="0.002" damping="0.001"/>
        <geom name="right_tire" type="cylinder" quat="1 1 0 0" size="0.1 0.025" mass="0.3" rgba="0.08 0.08 0.08 1"/>
      </body>
      <body pos="0.17 0 -0.12">
        <joint type="ball" damping="0.0001"/>
        <geom type="sphere" size="0.03" mass="0.02" rgba="0.4 0.4 0.4 1"/>
      </body>
      <body pos="-0.17 0 -0.12">
        <joint type="ball" damping="0.0001"/>
        <geom type="sphere" size="0.03" mass="0.02" rgba="0.4 0.4 0.4 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="left_wheel" ctrllimited="true" ctrlrange="-1.5 1.5"/>
    <motor joint="right_wheel" ctrllimited="true" ctrlrange="-1.5 1.5"/>
  </actuator>
</mujoco>
